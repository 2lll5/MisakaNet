# MisakaHub configuration example.
#
# All credential values must be supplied through environment variables.
# This file only describes the schema; copy it to ./hub/config.yaml and
# leave the `${VAR}` placeholders intact — hub/misaka_hub.py:_load_config
# performs env-var substitution at load time.
#
# Notification channels (notifier.*) are independently optional; enable
# the ones you actually use. See hub/sync/feishu_notifier.py for Feishu.

hub:
  name: "misaka-hub"
  host: "0.0.0.0"
  port: 8080
  protocol_version: "1.0"

storage:
  vector_store:
    type: "chroma"
    persist_dir: "./hub/storage/vector_store"
    collection_name: "skills"
  graph:
    type: "networkx"
    persist_path: "./hub/storage/knowledge_graph/graph.gpickle"
  metadata:
    type: "sqlite"
    db_path: "./hub/storage/metadata.db"

sync:
  interval_minutes: 30
  retry_attempts: 3
  retry_delay_seconds: 60
  timeout_seconds: 300

notifier:
  discord:
    enabled: false
    webhook_url: "${DISCORD_WEBHOOK_URL}"
  slack:
    enabled: false
    webhook_url: "${SLACK_WEBHOOK_URL}"
  # Feishu — reuses Hermes Agent's bot credentials when set.
  # Source ~/.hermes/.env (Hermes reads the same vars in
  # ~/.hermes/hermes-agent/gateway/run.py around line 1675), or export
  # them directly. FEISHU_APP_ID is enough to auto-enable; FEISHU_HOME_CHANNEL
  # is the default chat_id target.
  feishu:
    enabled: ${FEISHU_APP_ID:+true}
    app_id: "${FEISHU_APP_ID}"
    app_secret: "${FEISHU_APP_SECRET}"
    home_channel: "${FEISHU_HOME_CHANNEL}"
    domain: "${FEISHU_DOMAIN:-feishu}"
    timeout: 10
    max_message_length: 4000
    dry_run: false

master:
  token_ttl_hours: 24
  audit_log_days: 30
  keyring_service: "misaka-hub"
  shared_secret: "${MASTER_SHARED_SECRET}"

# a2a (agent-to-agent live transport) — REMOVED in the v2 refactor
# (see lessons/contrib/misakanet-refactor-v2-review.md). The directory
# archive/dead/ holds the retired a2a_server.py and feishu_ws_client.py
# for historical reference.
