{
  "name": "MisakaNet Public API Catalog",
  "description": "Public machine-readable endpoints of misakanet.org",
  "owner": {
    "name": "MisakaNet",
    "url": "https://github.com/Ikalus1988/MisakaNet"
  },
  "endpoints": [
    {
      "path": "/mcp",
      "method": "POST",
      "protocol": "mcp",
      "description": "Model Context Protocol server: 6 tools (search, get_lesson, submit_intake, write_lesson, preflight, register). Streamable HTTP + SSE."
    },
    {
      "path": "/api/health",
      "method": "GET",
      "description": "Worker health: token/KV status."
    },
    {
      "path": "/api/counter",
      "method": "GET",
      "description": "Registered node counter."
    },
    {
      "path": "/api/lessons",
      "method": "GET",
      "description": "Lessons index (GitHub-backed, KV-cached)."
    },
    {
      "path": "/api/helpful",
      "method": "GET,POST",
      "description": "\"This helped me\" vote and count."
    },
    {
      "path": "/api/feedback",
      "method": "POST",
      "description": "Search result feedback intake."
    },
    {
      "path": "/api/insights/demand-board",
      "method": "GET",
      "description": "Aggregate-only unsolved-failure demand board."
    },
    {
      "path": "/api/github/*",
      "method": "GET",
      "description": "GitHub API proxy (token-protected)."
    }
  ],
  "related": {
    "llms": "https://misakanet.org/llms.txt",
    "llmsFull": "https://misakanet.org/llms-full.txt",
    "mcpCard": "https://misakanet.org/.well-known/mcp.json",
    "agentCard": "https://misakanet.org/.well-known/agent-card.json"
  }
}
